        card.setMaximumWidth(560)
        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(38, 34, 38, 34)
        card_layout.setSpacing(8)

        eyebrow = QLabel(chapter_label)
        eyebrow.setProperty("role", "cyan")
