        badge.setFont(make_font(10, 700, spacing=1.6))
        badge_row.addWidget(badge)
        badge_row.addStretch(1)
        card_layout.addLayout(badge_row)
        card_layout.addSpacing(14)

        body = self._paragraph(body_text, role="muted", size=12.5)
