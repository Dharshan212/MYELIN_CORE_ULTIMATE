+    def _render_engine_organ_ring(self) -> None:
+        if self._ring_engine_status == "PAUSED":
+            return  # Preserve the existing paused, stationary SINE arc.
+        if self._ring_engine_status != "ACTIVE":
+            self._ring.set_progress(0.0)
